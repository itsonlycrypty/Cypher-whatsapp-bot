{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": "public",
  "installCommand": "npm install --no-audit",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
